{
  "name": "smb-web",
  "private": true,
  "dependencies": {
    "gl-matrix": "^3.4.3",
    "fastify": "^5.2.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "playwright": "^1.44.0",
    "@types/ws": "^8.5.13"
  },
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "esbuild src/main.ts --bundle --format=esm --target=es2022 --outdir=dist --sourcemap --define:process.env.NODE_ENV=\\\"production\\\" --external:gl-matrix",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=cjs --target=node18 --outdir=dist/server --external:fastify --external:@fastify/websocket --external:@fastify/static --external:ws",
    "build:watch": "esbuild src/main.ts --bundle --format=esm --target=es2022 --outdir=dist --sourcemap --define:process.env.NODE_ENV=\\\"development\\\" --external:gl-matrix --watch",
    "test:e2e": "node tests/e2e.mjs",
    "serve": "node server.js",
    "start": "node server.js"
  }
}
